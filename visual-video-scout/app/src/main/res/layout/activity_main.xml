<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#111318">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Visual Video Scout · MVP" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />

    <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="https://sito.example/video" android:inputType="textUri" android:singleLine="true"
        android:textColor="#FFFFFF" android:textColorHint="#8A8F98" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/openButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Apri" />
        <Button android:id="@+id/scanButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Scansiona" />
    </LinearLayout>

    <EditText android:id="@+id/queryInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="es. uomo con maglietta rossa" android:singleLine="true"
        android:textColor="#FFFFFF" android:textColorHint="#8A8F98" />

    <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="OpenAI API key (opzionale, resta nell’app)" android:singleLine="true"
        android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#8A8F98" />

    <Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cerca visivamente" />

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Apri un sito e avvia la scansione." android:textColor="#B7BBC5" android:textSize="13sp" android:maxLines="4" />

    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
